# Numerous always-ignore extensions
*.diff
*.err
*.log
*.orig
*.rej
*.swo
*.swp
*.vi
*~

# OS or Editor folders
._*
.cache
.DS_Store
.idea
.project
.settings
.tmproj
.publish
*.esproj
*.sublime-project
*.sublime-workspace
nbproject
Thumbs.db

# VSCode
.vscode/*
!.vscode/settings.json
!.vscode/launch.json

# Site status scanner
tests/e2e/status-report/reports/*
!tests/e2e/status-report/reports/.gitkeep

# HTML validation scanner (VNU)
tests/e2e/html-report/reports/*
!tests/e2e/html-report/reports/.gitkeep

# Node
node_modules

# Composer
/vendor/
composer.lock
.composer-cache/

# ignore node dependency directories
node_modules/

# ignore log files and databases
*.log
*.sql
*.sqlite

# Languages stuff
languages/*-backup-*.po~
languages/*-backup-*.pot~

# Ignore local AI context symlinks in project root
/AGENTS
/AGENTS.MD
/CLAUDE.MD
/DEV
.codex-tmp
.claude
.tmp
.codex
